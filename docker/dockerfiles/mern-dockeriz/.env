# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=mypass

# Backend
MONGODB_URI=mongodb://admin:mypass@mongo:27017/bookingdb?authSource=admin
JWT_SECRET=your_jwt_secret_here
NODE_ENV=production

# Frontend (Vite build-time vars must start with VITE_)
VITE_API_URL=http://yourdomain.com/api

# Admin (same pattern)
VITE_ADMIN_API_URL=http://yourdomain.com/api
